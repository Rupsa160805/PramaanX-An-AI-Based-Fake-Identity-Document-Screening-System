# PramaanX P4 — environment reference (copy to .env; never commit real secrets)
#
# Blockchain integrity chain (INPUT -> H1, ANALYSIS -> H2, FINAL -> H3)
# --------------------------------------------------------------------
# mock (default): in-memory, per-process anchoring — fine for demo/tests.
# real:           anchor to the local EVM via blockchain/blockchain_service.py.
#                 Requires a running `npx hardhat node`, a deployed contract,
#                 and web3 installed. All hashes are computed server-side.
BLOCKCHAIN_MODE=mock
# Address of the deployed PramaanXRegistry contract. If unset in real mode,
# blockchain_service.py falls back to blockchain/deployed_address.json.
# CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# OCR/MRZ/tampering pipeline that makes the ANALYSIS (H2) payload meaningful.
# Points at a module exposing run_pipeline(image_path) -> {ocr, mrz, tampering}.
# When unset it defaults to server.services.demo_document_pipeline (a
# self-guarding synthetic demo that only reads generated markers).
#
# For a REAL, trained model set:
#   P4_DOCUMENT_PIPELINE_MODULE=ai_pipeline.ai.pipeline
# This runs EasyOCR text/MRZ extraction and a fine-tuned ResNet18 tamper
# classifier on the actual pixels. One-time setup:
#   pip install easyocr torch torchvision            # EasyOCR + PyTorch (CPU ok)
#   python ai_pipeline/ai/ml/build_dataset.py        # build genuine/tampered set
#   python ai_pipeline/ai/ml/train.py                # -> ai_pipeline/ai/ml/tampering_model.pth
# The shipped dataset builder is procedurally generated for demo use; retrain on
# a real labelled document corpus for production accuracy.

# Persistence — the integrity chain is stored on the verification record so it
# can be re-verified after the request (and after a restart) in either store.
P4_DATABASE_MODE=auto
# MONGODB_URI=            # never commit the Atlas URI
MONGODB_DATABASE=pramaanx
