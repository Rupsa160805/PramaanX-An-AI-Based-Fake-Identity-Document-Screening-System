# PramaanX blockchain core — environment template.
# Copy to .env and adjust. NEVER commit the real .env (it is git-ignored).

# JSON-RPC endpoint of the local EVM (Hardhat or Ganache).
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Deployed contract address. Leave empty to auto-read deployed_address.json
# (written by scripts/deploy.js).
CONTRACT_ADDRESS=

# OPTIONAL, LOCAL DEV ONLY: private key used to sign transactions.
# Leave empty to use the node's first unlocked account (recommended locally).
# Never put a real / funded key here and never commit it.
BLOCKCHAIN_PRIVATE_KEY=

