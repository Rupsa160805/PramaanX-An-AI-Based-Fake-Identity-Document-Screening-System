# ============================================================
# PramaanX — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file is in .gitignore — NEVER commit real secrets.
# ============================================================

# Application
APP_NAME=PramaanX
APP_VERSION=1.0.0
PIPELINE_VERSION=1.0.0
ENVIRONMENT=development

# CORS — comma-separated list of allowed frontend origins
# Example for local React dev server:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload
MAX_UPLOAD_BYTES=10485760       # 10 MB
# TMP_DIR=                      # Defaults to system temp directory

# Logging
LOG_LEVEL=INFO

# Tampering Model
# Leave empty to use the default path: ai/ml/tampering_model.pth
# TAMPERING_MODEL_PATH=

# Database / Mock
MOCK_DATABASE=true
